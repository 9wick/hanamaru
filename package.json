{
  "name": "hanamaru",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./docs/spec/hanamaru.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "hanamaru": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p docs/spec/tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "test:runtime": "node --test test/runtime.test.js",
    "test:cli": "npm run build && node --test test/cli.test.js",
    "test:e2e": "npm run build && node --test test/e2e.test.js",
    "check:docs": "python3 scripts/check-docs.py",
    "lint": "vp lint --deny-warnings src test docs/examples",
    "format": "vp fmt src test vite.config.ts",
    "format:check": "vp fmt --check src test vite.config.ts",
    "build": "vp pack",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:docs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite-plus": "1.0.0-rc.0"
  },
  "dependencies": {
    "@hanamaru/vite": "npm:vite@8.3.0",
    "@types/node": "22.18.0",
    "acorn": "8.15.0"
  }
}
